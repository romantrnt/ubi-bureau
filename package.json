{
  "name": "ubi-bureau",
  "version": "0.3.0",
  "description": "A local-first 3D office for coding agents, with a native Linux window.",
  "bin": {
    "ubi-bureau": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "assets",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agents",
    "dashboard",
    "monitor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romantrnt/ubi-bureau.git"
  },
  "homepage": "https://github.com/romantrnt/ubi-bureau#readme",
  "bugs": {
    "url": "https://github.com/romantrnt/ubi-bureau/issues"
  },
  "author": "romantrnt",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "three": "^0.186.1"
  },
  "scripts": {
    "build": "esbuild web/office3d.js --bundle --format=esm --minify --target=es2020 --outfile=public/office3d.js --legal-comments=eof",
    "start": "node bin/cli.js",
    "test:ui": "node tests/ui.cjs",
    "test:watcher": "node --test tests/watcher.cjs tests/omp.cjs",
    "test:magpie": "node --test tests/magpie.cjs",
    "test:copilot": "node --test tests/copilot.cjs",
    "test:antigravity": "node --test tests/antigravity.cjs",
    "test:external": "node --test tests/external.cjs",
    "test:hook": "node --test tests/hook.cjs tests/usage.cjs",
    "test:transcript": "node --test tests/transcript.cjs",
    "test:server": "node --test tests/server.cjs",
    "test:clients": "node --test tests/clients.cjs",
    "test:ui:clients": "node tests/ui-clients.cjs",
    "test": "node --test tests/watcher.cjs tests/omp.cjs tests/magpie.cjs tests/copilot.cjs tests/antigravity.cjs tests/external.cjs tests/hook.cjs tests/usage.cjs tests/transcript.cjs tests/server.cjs tests/clients.cjs tests/dot-snapshot.cjs tests/updates.cjs tests/office-lifecycle.cjs tests/mascots.mjs",
    "test:bureau": "node tests/run-bureau.cjs",
    "appimage": "bash scripts/build-appimage.sh",
    "test:updates": "node --test tests/updates.cjs tests/office-lifecycle.cjs"
  }
}
